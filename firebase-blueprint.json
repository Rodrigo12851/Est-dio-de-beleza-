{
  "entities": {
    "store_config": {
      "title": "Store Configuration",
      "description": "Lingerie e-commerce store settings, brand info, WhatsApp and payment settings",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "ownerName": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "instagram": { "type": "string" },
        "address": { "type": "string" },
        "pickupInstructions": { "type": "string" },
        "pixKey": { "type": "string" },
        "enableOnlinePayment": { "type": "boolean" },
        "announcementBar": { "type": "string" },
        "adminPin": { "type": "string" },
        "logo": { "type": "string" },
        "bannerImage": { "type": "string" }
      },
      "required": ["name", "whatsapp", "adminPin"]
    },
    "categories": {
      "title": "Categories",
      "description": "Lingerie product categories (e.g. Conjuntos, Sutiãs, Calcinhas, Noivas)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "imageUrl": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "slug", "isActive"]
    },
    "products": {
      "title": "Products",
      "description": "Lingerie & apparel catalog products",
      "type": "object",
      "properties": {
        "categoryId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "promoPrice": { "type": "number" },
        "images": { "type": "array" },
        "variants": { "type": "array" },
        "isActive": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["categoryId", "name", "price", "images", "variants", "isActive"]
    },
    "orders": {
      "title": "Orders",
      "description": "Customer orders received via WhatsApp checkout or store",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerWhatsapp": { "type": "string" },
        "deliveryType": { "type": "string" },
        "address": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["orderNumber", "customerName", "customerWhatsapp", "totalAmount", "status"]
    }
  }
}
